{
  "schema_version": 1,
  "purpose": "Asteriq long-form, open-source animation production worker",
  "deployment_mode": "runpod_serverless_only",
  "deployment_policy": "No Pods, paid model APIs, or permanently running workers. Every stage scales to zero after its Serverless job completes.",
  "execution_guard": "operator_start_required",
  "visual_style_policy": {
    "default": "bold_graphic_2d",
    "photorealism_requires_explicit_opt_in": true,
    "presets": ["bold_graphic_2d", "anime_illustration", "stylized_3d", "painterly_animation", "photorealistic"]
  },
  "final_durations_seconds": [60, 300, 600],
  "internal_checkpoint_seconds": 10,
  "model_cache_root": "/runpod-volume/models",
  "cost_profiles": {
    "fast_economy": {
      "target_eur_per_output_minute": 1,
      "maximum_gpu_seconds_per_output_minute": 1500,
      "strategy": "track locally first, retarget reusable rig, render reusable set, use LTX only for approved hero shots and transitions",
      "cache": ["character version", "virtual set", "camera and lighting", "performer tracks", "voice profile", "unchanged shots"],
      "4k": "requires a separately approved finishing budget"
    },
    "economy": {
      "target_eur_per_output_minute": 1,
      "maximum_gpu_seconds_per_output_minute": 3600,
      "strategy": "track once, retarget reusable rig, render reusable set, apply generative look only to approved shots",
      "cache": ["character version", "virtual set", "camera and lighting", "performer tracks", "voice profile", "unchanged shots"],
      "4k": "requires a separately approved finishing budget"
    },
    "generative": {
      "strategy": "use continuity-conditioned generative animation windows",
      "cache": ["character version", "virtual set", "performer tracks", "unchanged shots"]
    }
  },
  "price_guard": {
    "currency": "USD",
    "hourly_price_ceilings": {"L4": 0.69, "RTX_4090": 1.1},
    "worst_case_hourly_price": 1.1,
    "require_worker_quote_before_compute": true,
    "on_missing_or_over_ceiling_quote": "leave job queued and require operator review",
    "rule": "estimate and reserve the job at the RTX 4090 ceiling until the worker returns its actual quoted rate; never use the L4 price as an assumption"
  },
  "stages": [
    {"id": "concept_design", "component": "Segmind SSD-1B", "purpose": "open-source concept frames and character/set design sheets"},
    {"id": "track", "component": "SAM 2.1 Hiera Tiny", "purpose": "per-person masks and tracking"},
    {"id": "performance", "component": "DWPose / ControlNet Aux", "purpose": "body and gesture guidance"},
    {"id": "character", "component": "TRELLIS.2 + rig repair", "purpose": "reference-to-3D character assets"},
    {"id": "animate", "component": "LTX-Video 2B 0.9.6 distilled", "purpose": "style-conditioned image/video animation windows on 24 GB workers"},
    {"id": "voice", "component": "OpenVoice V2", "purpose": "stable, per-character voice transformation"},
    {"id": "upscale", "component": "Real-ESRGAN x4plus", "purpose": "approved 4K finishing"},
    {"id": "assemble", "component": "FFmpeg", "purpose": "one synchronized minute-length MP4"}
  ],
  "safety": {
    "model_training": false,
    "paid_model_apis": false,
    "runpod_submission": false,
    "requires_explicit_operator_start": true
  }
}
