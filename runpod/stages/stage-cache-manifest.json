      },
      {
        "id": "faster-whisper-small",
        "repository": "Systran/faster-whisper-small",
        "destination": "audio/faster-whisper-small",
        "revision": "main"
      },
      {
        "id": "marian-en-de",
        "repository": "Helsinki-NLP/opus-mt-en-de",
        "destination": "audio/marian-en-de",
        "revision": "main"
      },
      {
        "id": "marian-de-en",
        "repository": "Helsinki-NLP/opus-mt-de-en",
        "destination": "audio/marian-de-en",
        "revision": "main"
      },
      {
        "id": "latentsync-1.6",
        "repository": "ByteDance/LatentSync-1.6",
        "destination": "audio/latentsync-1.6",
        "revision": "main"
      }
